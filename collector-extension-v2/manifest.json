{
  "manifest_version": 3,
  "name": "Kolektor ePerjadin V2.2 (Lokal)",
  "version": "2.2.0",
  "description": "Ekstraksi lokal SPD, validasi presensi kosong, dan indeks status laporan kegiatan.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://satu.kemenkeu.go.id/*"
  ],
  "action": {
    "default_title": "Kolektor ePerjadin V2",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://satu.kemenkeu.go.id/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
