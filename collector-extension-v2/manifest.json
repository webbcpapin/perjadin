{
  "manifest_version": 3,
  "name": "Kolektor ePerjadin V2.1 (Lokal)",
  "version": "2.1.0",
  "description": "Membaca daftar dan detail SPD lewat sesi pengguna aktif, menyimpan data lokal dan membandingkan perubahan.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://satu.kemenkeu.go.id/*"
  ],
  "action": {
    "default_title": "Kolektor ePerjadin V2",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://satu.kemenkeu.go.id/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
