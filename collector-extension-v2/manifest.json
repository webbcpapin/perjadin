{
  "manifest_version": 3,
  "name": "Kolektor ePerjadin V2.3 (Lokal)",
  "version": "2.3.0",
  "description": "Pengambilan lokal kegiatan, pelaksana, detail SPD dan presensi dengan progres yang dapat dilanjutkan.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://satu.kemenkeu.go.id/*"
  ],
  "action": {
    "default_title": "Kolektor ePerjadin V2",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://satu.kemenkeu.go.id/*"
      ],
      "js": [
        "collector-core.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
